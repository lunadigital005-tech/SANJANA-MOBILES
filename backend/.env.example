# SANJANA MOBILES Backend Configuration
PROJECT_NAME="SANJANA MOBILES API"
API_V1_STR="/api/v1"
STORE_NAME="SANJANA MOBILES"
ENVIRONMENT="production"
PORT=8000

# CORS Configuration (comma-separated origins for production frontend)
# e.g. https://sanjanamobiles.onrender.com,https://sanjanamobiles.com
CORS_ORIGINS="https://sanjana-mobiles.vercel.app,http://localhost:5173,http://localhost:3000"

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Razorpay Credentials (Optional / UPI primary)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
